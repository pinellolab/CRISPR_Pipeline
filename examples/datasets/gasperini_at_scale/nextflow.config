// CRISPR Pipeline v1.1.0 · Gasperini at-scale K562 CRISPRi
// Source settings: rerun_paper_filters_20261123.
// Assay overlay. Supply the resolved --input, --outdir, and your executor profile.
// The default checkpoint finishes Post Concatenation QC. Use --ANALYSIS_mode full for inference.

// ----------------------------------------------------------------------------
// 1. Essential settings
// ----------------------------------------------------------------------------
// Active lines are assay overrides. Commented lines show inherited defaults to review.
params {
    // Inputs and run mode
    // input = null
    // outdir = './pipeline_outputs'
    // ANALYSIS_mode = 'checkpoint'

    // Assay and read processing
    // Multiplicity_of_infection = 'high'
    // ENABLE_DATA_HASHING = false
    // DUAL_GUIDE = false
    // is_BaseEditing = false
    // scrna_workflow = 'standard'
    // use_multimapping = false
    // replace_barcodes = false
    // bc_replacement_file = ''
    // is_10x3v3 = false
    // reverse_complement_guides = false
    // A spacer tag enables whole-read guide search. Verify in SeqSpec QC.
    // spacer_tag = ''

    // RNA reference and annotation
    // REFERENCE_transcriptome = 'human'
    // use_igvf_reference = true
    // REFERENCE_gtf_download_path = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gtf.gz'
    // REFERENCE_gtf_local_path = '/path/to/gencode_gtf.gtf.gz'
    // REFERENCE_restrict_genes_to_gtf = false
    // TAPSEQ_QC_MODE = false

    // RNA and cell QC
    // The barcode-rank plot is automatic. 'none' skips knee filtering and keeps the plot.
    // QC_barcode_filter = 'knee2'
    QC_min_counts_per_cell = 3550
    QC_MAD_total_counts = 0
    QC_MAD_n_genes = 0
    QC_pct_mito = 10
    QC_min_cells_per_gene = 0.00525
    ENABLE_SCRUBLET = false

    // Guide assignment and inference
    // GUIDE_ASSIGNMENT_method = 'sceptre'
    GUIDE_ASSIGNMENT_capture_method = 'direct-capture'
    // INFERENCE_method = 'default'
    // Applies only to distance-based local pairs.
    // INFERENCE_max_target_distance_bp = 1000000

    // Site resource limits
    // max_cpus = 128
    // max_memory = '256.GB'
}

// ----------------------------------------------------------------------------
// 2. Advanced overrides
// ----------------------------------------------------------------------------
params {
    QC_require_assigned_guide = false
    // Zero leaves the number of assigned guides per cell uncapped.
    GUIDE_ASSIGNMENT_max_guides_per_cell = 0
}

// Local execution HTML works without Weights & Biases upload.
params.DASHBOARD_PLUGIN.upload = false
