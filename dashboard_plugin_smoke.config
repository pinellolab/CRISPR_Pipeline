plugins {
    id 'nf-crispr-dashboard@0.1.0'
}

params.outdir = '/data/pinello/lucas_logan/CRISPR_Pipeline_dashboard_plugin_20261021/.dashboard-plugin-smoke-results'
params.containers = [base: 'ghcr.io/pinellolab/crispr_pipeline/conda-docker@sha256:9ef5de70f7ab289eb60861e6db21d1ed68727c07a3bd411747b8e854739553f0']

// The tiny shell task needs no scientific image. The dashboard renderer below
// still executes inside the pinned pipeline image.
singularity.enabled = false

params.DASHBOARD_PLUGIN = [
    enabled: true,
    upload: false,
    pollSeconds: 2,
    image: 'ghcr.io/pinellolab/crispr_pipeline/conda-docker@sha256:9ef5de70f7ab289eb60861e6db21d1ed68727c07a3bd411747b8e854739553f0',
    imageLibraryDir: '/srv/local/lf588_tf_benchmark_runs/shared_containers',
    server: [enabled: true, host: '127.0.0.1', port: 18787, refreshSeconds: 2]
]
