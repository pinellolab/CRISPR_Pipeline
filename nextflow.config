includeConfig 'conf/provenance.config'

params {
    input = '../sample_metadata_gcp_2026_06_10_patched.csv'
    // Pre-run only: select the complete measurement set with the fewest scRNA FASTQ files.
    DEMO_MODE = true

    // TO-DO, pipeline parameters
    ENABLE_DATA_HASHING = false
    ENABLE_SCRUBLET = false
    use_igvf_reference = true
    is_10x3v3 = false
    reverse_complement_guides = true
    //example of sequence in front of the guide (see guidefastfile or run seqspec checker(implementing...) ): TAGCTCTTAAAC. This will deactivate the guideseqspec precise search and search in the whole read
    spacer_tag = 'TAGCTCTTAAAC'
    DUAL_GUIDE = false
    REFERENCE_transcriptome = 'human'
    REFERENCE_gtf_download_path = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gtf.gz'
    REFERENCE_gtf_local_path = '/path/to/gencode_gtf.gtf.gz'

    QC_min_genes_per_cell = 500
    QC_min_counts_per_cell = 0
    QC_min_cells_per_gene = 0.05
    TAPSEQ_QC_MODE = false
    QC_pct_mito = 15

    Multiplicity_of_infection = 'high'
    GUIDE_ASSIGNMENT_method = 'sceptre'
    GUIDE_ASSIGNMENT_capture_method = 'direct-capture'
    //GUIDE_ASSIGNMENT_method = 'cleanser'
    //GUIDE_ASSIGNMENT_capture_method = 'crop-seq'
    GUIDE_ASSIGNMENT_cleanser_probability_threshold = 1
    GUIDE_ASSIGNMENT_SCEPTRE_probability_threshold = 'default'
    GUIDE_ASSIGNMENT_SCEPTRE_n_em_rep = 'default'

    INFERENCE_method = 'default'
    INFERENCE_target_guide_pairing_strategy = 'default'
    INFERENCE_PERTURBO_DEVICE = 'gpu'
    INFERENCE_PERTURBO_NUM_STEPS_CONTROL = 2500
    INFERENCE_PERTURBO_NUM_STEPS_BETAS = 300
    INFERENCE_PERTURBO_MAX_CHUNK_CELLS = 20000
    INFERENCE_PERTURBO_LOCAL_MAX_CHUNK_CELLS = 20000
    // Local/cis runs can fit element- and guide-level models concurrently on
    // two GPUs. Keep disabled by default for single-GPU machines.
    INFERENCE_PERTURBO_LOCAL_PARALLEL_FITS = false
    INFERENCE_PERTURBO_ELEMENT_GPU = '0'
    INFERENCE_PERTURBO_GUIDE_GPU = '0'
    INFERENCE_PERTURBO_JAX_CACHE_DIR = '.perturbo_jax_cache'
    INFERENCE_PERTURBO_SAVE_MODEL_PARAMS = false
    INFERENCE_PERTURBO_SIZE_FACTOR_MODE = 'observed'
    INFERENCE_PERTURBO_LIKELIHOOD = 'negbin'
    INFERENCE_PERTURBO_PRIOR = 'normal'

    INFERENCE_predefined_pairs_to_test = 'path/to/file.csv'
    INFERENCE_max_target_distance_bp = 1000000
    INFERENCE_PERTURBO_GLOBAL_RESULTS_FORMAT = 'parquet'
    // The conditional randomization test runs beside the effect estimates. Its pool
    // follows Multiplicity_of_infection (high -> all cells, low -> control-anchored);
    // 'auto' lets PerTurbo measure the design, or name a pool outright.
    INFERENCE_PERTURBO_CRT = true
    INFERENCE_PERTURBO_CRT_POOL = 'from-moi'

    INFERENCE_SCEPTRE_side = 'both'
    INFERENCE_SCEPTRE_grna_integration_strategy = 'union'
    INFERENCE_SCEPTRE_resampling_approximation = 'skew_normal'
    INFERENCE_SCEPTRE_control_group = 'complement'
    INFERENCE_SCEPTRE_resampling_mechanism = 'default'
    INFERENCE_SCEPTRE_formula_object = 'default'

    // Use CRISPR-Correct ambiguous guide mapping for base-editing assays.
    // This remains opt-in so the existing guide mapper is unchanged for other assays.
    is_BaseEditing = false
    BASEEDITING_method = 'legacy'
    BASEEDITING_FLASH_tolerance = 5
    BASEEDITING_FLASH_guide_len = 0
    BASEEDITING_FLASH_device = 'auto'
    BASEEDITING_FLASH_fastq_chunk_size = 200000
    BASEEDITING_FLASH_gpu_read_chunk = 4096


    NETWORK_custom_central_nodes = 'undefined'
    NETWORK_central_nodes_num = 1

    // Dashboard parameters
    css = "${projectDir}/assets/css"
    js = "${projectDir}/assets/js"
    svg = "${projectDir}/assets/svg"

    // Resource Limit
    max_cpus = 128      // TO-DO, YOU set this limit
    max_memory = 256.GB  // TO-DO, YOU set this limit

    // Container
    containers {
        // Pinned (not :latest) so merge/catalog steps reliably get pyarrow;
        // :latest on GHCR predates pyarrow being added to nextflow.yaml and
        // is only rebuilt via manual workflow_dispatch of conda_docker.yml.
        base     = 'ghcr.io/pinellolab/crispr_pipeline/conda-docker:sha-91bc741'
        cleanser = 'ghcr.io/gersbachlab-bioinformatics/cleanser:1.2.1'
        sceptre  = 'sjiang9/sceptre-igvf:0.2'
        // Logan's immutable PerTurbo v2 JAX image with native --pairs-to-test.
        // Local/cis passes an exact pair table; global/trans omits the option.
        perturbo = 'ghcr.io/pinellolab/perturbo:v2.0.0rc1'
        aria2    = 'biasofpriene/aria2c'
        bediting = 'bioinfolucas/crispr_mapping:latest_0236'
        gmmdemux = 'ghcr.io/lucassilvaferreira/gmm_demux_docker_crisprpipeline:latest'

    }

    // TO-DO, Google Cloud specific parameters
    google_bucket = 'gs://igvf-pertub-seq-pipeline-data'
    google_project = 'igvf-pertub-seq-pipeline'
    google_region = 'us-central1'

    // Boilerplate options
    outdir                       = 'igvf-pertub-seq-pipeline-data/CRISPRi_lineage_atlas/v0.0.2-3/Gersbach_WTC11-hepatocyte-differentiation_TF-Perturb-seq'
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null

    // NOTE: accepted by PIPELINE_INITIALISATION but not currently consumed
    // there -- schema validation isn't actually wired up yet. Defaulting
    // this just silences the "undefined parameter" warning.
    validate_params               = true
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null
}


// Define compute profiles
profiles {
    // Local profile
    local {
        process {
            executor = 'local'
            errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        }

        // Optional: Set work/singularity-cache directory for local runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // TO-DO, SLURM profile
    slurm {
        process {
            executor = 'slurm'
            queue = 'short,normal,long' // TO-DO, modify the SLURM partition
            errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        }

        executor {
            name = 'slurm'
            queueSize = 100
            pollInterval = '30 sec'
            submitRateLimit = '10 sec'
        }
        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // Google Cloud profile
    google {

        process {
            executor = 'google-batch'
            errorStrategy = {
                if (task.exitStatus == 0) {
                    return 'ignore'
                } else if (task.exitStatus in [137, 143, 50001, 50002, 50003, 50006]) {
                    return 'retry'
                } else {
                    return 'terminate'
                }
            }
            maxRetries = 3
        }

        executor.exitReadTimeout = '10 min'

        google {
            project = params.google_project
            location = params.google_region
            batch.spot = true
            batch.maxSpotAttempts  = 5
            httpReadTimeout  = '1800 s'
            httpConnectTimeout   = '600 s'
            batch.bootDiskSize = 100.GB
        }

        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = "${params.google_bucket}/work"
        singularity.cacheDir = "${params.google_bucket}/singularity-cache"
    }
}

// Global process configuration
process {

    // Never execute a pipeline process with the host software environment.
    // Process-specific container directives below override this base image.
    container = { params.containers.base }

    // Publishing is opt-in: only processes that declare their own publishDir
    // (the actual deliverables) publish anything. Without this, every process
    // lacking its own publishDir directive -- including full MuData
    // pass-through stages like PreprocessAnnData, mudata_concat,
    // prepare_guide_inference, mergedResults, etc. -- would each publish a
    // full copy of their output, bloating pipeline_outputs/ with redundant
    // intermediate checkpoints nobody needs. A process's own publishDir
    // directive (e.g. mergeMudata's) fully replaces this default regardless
    // of `enabled` here, so real deliverables are unaffected.
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        // PublishDir.setMode() only accepts a String/Mode, not a closure
        // (unlike `container`) -- must stay a bare reference. This is safe
        // from the earlier eager-evaluation bug in practice: this default is
        // enabled:false, so no process actually publishes through it, and no
        // -c override needs to reach it.
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    withName: 'downloadGTF|downloadGenome|skipGenomeDownload|skipGTFDownload|anndata_concat|createGuideRef|createHashingRef|seqSpecCheck|createDashboard_HASHING|createDashboard|createDashboard_HASHING_default|createDashboard_default|CreateMuData_HASHING|CreateMuData|demultiplex|doublets_scrub|filter_hashing|hashing_concat|prepare_assignment|mudata_concat|inference_mudata|prepare_guide_inference|prepare_user_guide_inference|prepare_all_guide_inference|PreprocessAnnData|seqSpecParser|prepare_covariate|mergedResults|publishFiles|mergeMudata|buildCatalogElement|buildCatalogGuide|evaluation_plot|evaluation_controls|evaluation_undefined_plot|evaluation_plot_default|evaluation_undefined_plot_default|evaluation_controls' {
        container = { params.containers.base }
        cpus = { Math.min(4 * task.attempt, params.max_cpus) }
        memory = { [50.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-16' : null
        }
    }

    // Higher resource processes
    withName: 'mappingGuide|mappingHashing|mappingscRNA' {
        container = { params.containers.base }
        cpus = 8
        memory = 32.GB
        disk = 300.GB
        machineType = {
            workflow.profile == 'google' ? 'n4-standard-8' : null
        }
    }

    withName: 'mappingGuideBaseEditing|mappingGuideBaseEditingFlash' {
        container = { params.containers.bediting }
        cpus = { Math.min(8 * task.attempt, params.max_cpus) }
        memory = { [200.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-64' : null
        }
    }


    withName: 'guide_assignment_cleanser' {
        container = { params.containers.cleanser }
        cpus = { Math.min(8 * task.attempt, params.max_cpus) }
        memory = { [300.GB * task.attempt, params.max_memory].min() }
        machineType = 'n2-highmem-32'
        scratch = '/tmp'
        disk = '500 GB'
        // machineType = {
        //    workflow.profile == 'google' ? 'n2-highmem-64' : null
        //}
        //google {
        //    batch.spot = false
        //    batch.scratch = true
        //    batch.disk = '500 GB'
        //}
    }

    withName: 'guide_assignment_sceptre' {
        container = { params.containers.sceptre }
        cpus = 16
        memory = 128.GB
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-16' : null
        }
    }

    withName: 'inference_sceptre' {
        container = { params.containers.sceptre }
        // Align CPUs with downloadGTF|downloadGenome steps
        cpus = { Math.min(8 * task.attempt, params.max_cpus) }
        memory = 100.GB
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-32' : null
        }
    }

    withName: 'inference_perturbo' {
        container = { params.containers.perturbo }
        // GPU processes
        cpus = { Math.min(8, params.max_cpus) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = 'a2-highgpu-1g'
        accelerator = [ request: 1, type: 'nvidia-tesla-a100' ]

        // SLURM specific
        clusterOptions = { workflow.profile == 'slurm' ? '--gres=gpu:4' : null }
    }

    withName: 'downloadReference' {
        container = { params.containers.aria2 }
        // GPU processes
        cpus = { Math.min(4 * task.attempt, 48) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = 'n1-highmem-32'
       // accelerator  = [request: 1, type: 'nvidia-tesla-t4']
    }

}

// Large result-table operations are vectorized and memory bounded, but benefit
// from enough threads to parallelize Parquet decoding, joins, compression, and
// external sorting. Keeping these selectors explicit also makes their resource
// contract stable across generated-config sections above.
process {
  withName: 'mergeMudata|buildCatalogElement|buildCatalogGuide' {
    container = { params.containers.base }
    cpus = { Math.min(16, params.max_cpus) }
    memory = { [200.GB, params.max_memory].min() }
  }
}



// Singularity configuration
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--nv'
}

// Tower configuration
tower {
    enabled = System.getenv('TOWER_ACCESS_TOKEN') ? true : false
    accessToken = System.getenv('TOWER_ACCESS_TOKEN') ?: ''
}

// Execution reporting
trace {
    enabled = false
    file = 'pipeline_trace.txt'
    overwrite = true
}

// Additional reporting
report {
    enabled = false
    file = 'execution_report.html'
    overwrite = true
}

timeline {
    enabled = false
    file = 'timeline_report.html'
    overwrite = true
}



// --- Auto-injected by Pipeline Configurator ---
params {
  scrna_workflow = 'standard'
  use_multimapping = false
  replace_barcodes = false
  bc_replacement_file = ''
  QC_barcode_filter = 'knee'
  INFERENCE_SCEPTRE_CHUNK_MODE = 'auto'
  INFERENCE_SCEPTRE_GENE_CHUNK_SIZE = 1000
  ENABLE_BENCHMARK = false
}

// --- Computational resource overrides injected by Pipeline Configurator ---
params {
  max_cpus = 128
  max_memory = 600.GB
}

process {
  cpus = { Math.min(16 * task.attempt, params.max_cpus) }
  memory = { [200.GB * task.attempt, params.max_memory].min() }

  withName: 'additional_qc_plots' {
    container = { params.containers.base }
    cpus = { Math.min(4 * task.attempt, params.max_cpus) }
    memory = { [50.GB * task.attempt, params.max_memory].min() }
    machineType = {
      workflow.profile == 'google' ? 'n2-highmem-16' : null
    }
  }

  withName: 'mappingGuide|mappingHashing|mappingscRNA' {
    cpus = 8
    memory = 32.GB
    maxRetries = 2
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
  }

  withName: 'guide_assignment_cleanser' {
    scratch = true
    disk = '500 GB'
  }

  withName: 'guide_assignment_sceptre' {
    cpus = 16
    memory = 128.GB
    machineType = {
      workflow.profile == 'google' ? 'n2-highmem-16' : null
    }
  }

  withName: 'inference_sceptre' {
    cpus = { Math.min(8 * task.attempt, params.max_cpus) }
    memory = 100.GB
  }

  withName: 'sceptre_chunk_prepare|sceptre_chunk_merge' {
    container = { params.containers.sceptre }
    cpus = { Math.min(8, params.max_cpus) }
    memory = { [100.GB, params.max_memory].min() }
  }

  withName: 'inference_perturbo' {
    container = { params.containers.perturbo }
    cpus = { Math.min(8, params.max_cpus) }
    memory = { [100.GB * task.attempt, params.max_memory].min() }
    machineType = 'a2-highgpu-1g'
    accelerator = [ request: 1, type: 'nvidia-tesla-a100' ]
  }


withName: 'demultiplex' {
    container = params.containers.gmmdemux

}



}

// --- Auto-injected by Pipeline Configurator ---
params {
  QC_batch_col = 'batch'
  INFERENCE_input_mudata = ''
  INFERENCE_PERTURBO_GLOBAL_RESULTS_FORMAT = 'parquet'
  INFERENCE_SCEPTRE_MAX_MATRIX_ENTRIES = 2147483647
  INFERENCE_SCEPTRE_FORCE_CHUNK = false
  // Resolve independently of the directory from which Nextflow is launched.
  ENCODE_BED_DIR = "${projectDir}/encode_bed_files"
  // Enables verbose debug printing/artifact dumps in CreateMuData; off by
  // default so normal runs don't get flooded with debug output.
  DEBUG_VAR = false
}

