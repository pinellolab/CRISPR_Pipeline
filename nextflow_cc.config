includeConfig 'conf/provenance.config'

// nextflow.config (in the pipeline root) is always loaded automatically, even
// when this file is also passed via `-c`. Everything below is a deliberate
// DELTA from nextflow.config's defaults for this site -- do not restate
// values that already match nextflow.config, since Nextflow deep-merges
// params/containers maps and duplicated values just drift out of sync
// silently (as INFERENCE_PERTURBO_MAX_CHUNK_CELLS and containers.perturbo did).
params {
    input = null
    outdir = './pipeline_outputs'

    // check your output dir seqspeccheck/guide_seqSpec_plots and check what
    // is the recommended value given your current metadata
    reverse_complement_guides = false
    spacer_tag = ""

    scrna_workflow = "nac"
    use_multimapping = true
    replace_barcodes = true
    bc_replacement_file = 'assets/barcode_3_2_1_bc1_replacement.tsv'

    REFERENCE_gtf_download_path = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.annotation.gtf.gz'

    // Use knee-based barcode filtering instead of QC_min_genes_per_cell; options: 'none', 'knee', 'knee2'
    QC_barcode_filter = 'none'

    GUIDE_ASSIGNMENT_capture_method = 'crop-seq'

    // FIXME: this is the pre-fix default that OOMs on a 16GB GPU (see
    // nextflow.config, which uses 20000). Confirm this site's GPUs have
    // enough VRAM for 50000 before relying on it, or lower to match.
    INFERENCE_PERTURBO_MAX_CHUNK_CELLS = 50000

    ENABLE_BENCHMARK = true

    // Per-process resource limits
    max_cpus = 64      // TO-DO, YOU set this limit
    max_memory = 400.GB  // TO-DO, YOU set this limit

    containers {
        // FIXME: pre-cortado v1 image -- nextflow.config now points perturbo
        // at v2-dev (the cortado/PerTurbo-v2 CLI this pipeline integrates
        // against). Confirm whether this site intentionally hasn't upgraded
        // yet, or if this is stale and should match nextflow.config.
        perturbo = 'ghcr.io/pinellolab/perturbo:sha-91d5b51'
    }
}


// Define compute profiles
profiles {
    // Local profile
    local {
        process {
            executor = 'local'
            // errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        }

        // Optional: Set work/singularity-cache directory for local runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // TO-DO, SLURM profile
    slurm {
        process {
            executor = 'slurm'
            queue = 'short,normal,long' // TO-DO, modify the SLURM partition
            errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        }

        executor {
            name = 'slurm'
            queueSize = 100
            pollInterval = '30 sec'
            submitRateLimit = '10 sec'
        }
        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // Google Cloud profile
    google {

        process {
            executor = 'google-batch'
            errorStrategy = {
                if (task.exitStatus in [137, 143, 50001, 50002, 50003, 50006]) {
                    return 'retry'
                } else {
                    return 'terminate'
                }
            }
            maxRetries = 3
        }

        executor.exitReadTimeout = '10 min'

        google {
            project = params.google_project
            location = params.google_region
            batch.spot = true
            batch.maxSpotAttempts  = 5
            httpReadTimeout  = '1800 s'
            httpConnectTimeout   = '600 s'
            batch.bootDiskSize = 250.GB
        }

        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = "${params.google_bucket}/work"
        singularity.cacheDir = "${params.google_bucket}/singularity-cache"
    }
}

// Global process configuration
process {

    // publishDir is opt-in by default (see nextflow.config); inherited here
    // rather than duplicated.

    // default process requirements
    container = { params.containers.base }
    cpus = { Math.min(16, params.max_cpus) }
    memory = { [50.GB * task.attempt, params.max_memory].min() }
    machineType = {
        workflow.profile == 'google' ? 'n2-highmem-16' : null
    }
    

    // Higher resource processes
    withName: 'mappingGuide|mappingHashing|mappingscRNA' {
        container = { params.containers.base }
        cpus = { Math.min(32, params.max_cpus) }
        memory = { [250.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google'
                ? (task.memory <= 256.GB ? 'n2-highmem-32' : 'n2-highmem-64')
                : null
        }
        disk = { [250.GB * task.attempt, 400.GB].min() }
    }

    withName: 'mappingGuideBaseEditing|mappingGuideBaseEditingFlash' {
        container = { params.containers.bediting }
        cpus = { Math.min(32, params.max_cpus) }
        memory = { [250.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google'
                ? (task.memory <= 256.GB ? 'n2-highmem-32' : 'n2-highmem-64')
                : null
        }
        disk = { [250.GB * task.attempt, 400.GB].min() }
    }

    withName: 'guide_assignment_cleanser' {
        container = { params.containers.cleanser }
        cpus = { Math.min(16, params.max_cpus) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-32' : null
        }
        scratch = true
        disk = '500 GB'
    } 
    

    withName: 'guide_assignment_sceptre|inference_sceptre' {
        container = { params.containers.sceptre }
        // Align CPUs with downloadGTF|downloadGenome steps
        cpus = { Math.min(16, params.max_cpus) }
        memory = { [200.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google'
                ? (task.cpus <= 16 && task.memory <= 128.GB
                    ? 'n2-highmem-16'
                    : task.cpus <= 32 && task.memory <= 256.GB
                        ? 'n2-highmem-32'
                        : 'n2-highmem-64')
                : null
        }
    }

    withName: 'sceptre_chunk_prepare|sceptre_chunk_merge' {
        container = { params.containers.base }
        cpus = { Math.min(8 * task.attempt, params.max_cpus) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = {
            workflow.profile == 'google' ? 'n2-highmem-32' : null
        }
    }

    withName: 'inference_perturbo|inference_perturbo_global' {
        container = { params.containers.perturbo }
        // GPU processes
        cpus = { Math.min(8, params.max_cpus) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = 'a2-ultragpu-1g'

        accelerator = [ request: 1, type: 'nvidia-a100-80gb' ]

        // SLURM specific
        clusterOptions = { workflow.profile == 'slurm' ? '--gres=gpu:4' : null }
    }

    withName: 'downloadReference' {
        container = { params.containers.base }
        // GPU processes
        cpus = { Math.min(16, params.max_cpus) }
        memory = { [100.GB * task.attempt, params.max_memory].min() }
        machineType = 'n1-highmem-32'
       // accelerator  = [request: 1, type: 'nvidia-tesla-t4']
    }

}



// Singularity configuration
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--nv'
}

// Tower configuration
tower {
    enabled = System.getenv('TOWER_ACCESS_TOKEN') ? true : false
    accessToken = System.getenv('TOWER_ACCESS_TOKEN') ?: ''
}

// Execution reporting
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,cpus,time,memory,disk,attempt,container,workdir'
    overwrite = true
}

// Additional reporting
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
