// Pipeline release v1.1.0. Manifest version is defined in conf/provenance.config.
includeConfig 'conf/provenance.config'

// TAP-seq overlay for the chr8 amplification panel. Load with -c nextflow_tapseq.config.
// Supply an existing local panel GTF, samplesheet, and output directory.
// The root config is always loaded automatically. This file is a DELTA for the assay.

// ----------------------------------------------------------------------------
// 1. Essential settings
// ----------------------------------------------------------------------------
// Active lines are assay overrides. Commented lines show inherited defaults to review.
params {
    // Run mode and results. Supply --input /path/to/samplesheet.csv at launch.
    outdir = './pipeline_outputs'
    // ANALYSIS_mode = 'checkpoint'

    // Assay and read processing
    // Multiplicity_of_infection = 'high'
    // ENABLE_DATA_HASHING = false
    // DUAL_GUIDE = false
    // is_BaseEditing = false
    // scrna_workflow = 'standard'
    // use_multimapping = false
    // replace_barcodes = false
    // bc_replacement_file = ''
    // is_10x3v3 = false
    // reverse_complement_guides = false
    // A spacer tag enables whole-read guide search. Verify in SeqSpec QC.
    // spacer_tag = ''

    // RNA reference and annotation
    // REFERENCE_transcriptome = 'human'
    // use_igvf_reference = true
    // REFERENCE_gtf_download_path = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gtf.gz'
    // TO-DO: Set the actual panel GTF. A missing file falls back to the configured URL.
    // REFERENCE_gtf_local_path = '/path/to/your_panel.gtf.gz'
    REFERENCE_restrict_genes_to_gtf = true
    TAPSEQ_QC_MODE = true

    // RNA and cell QC
    // The barcode-rank plot is automatic. 'none' skips knee filtering and keeps the plot.
    QC_barcode_filter = 'knee2' // Preserve the chr8 example's cell-calling setting.
    // QC_min_counts_per_cell = 500
    // QC_MAD_total_counts = 5.0
    // QC_MAD_n_genes = 5.0
    // QC_pct_mito = 25
    QC_min_cells_per_gene = 0.000001
    // ENABLE_SCRUBLET = true

    // Guide assignment and inference
    // GUIDE_ASSIGNMENT_method = 'sceptre'
    GUIDE_ASSIGNMENT_capture_method = 'crop-seq'
    // INFERENCE_method = 'default'
    // Applies only to distance-based local pairs.
    // INFERENCE_max_target_distance_bp = 1000000

    // Site resource limits
    max_cpus = 16
    max_memory = '128.GB'
}

// ----------------------------------------------------------------------------
// 2. Advanced overrides
// ----------------------------------------------------------------------------
params {
    // Optional path for launches that get their samplesheet from a run-specific config.
    input = null

    // Legacy compatibility value. Use the RNA UMI and MAD settings above for cell QC.
    QC_min_genes_per_cell = 10

    // Crosstab non-targeting control cells by measurement set before choosing a contrast.
    // In the chr8 example, one lane held 2,033 of 2,049 control-only cells.
    // See the inference guide before overriding the inherited control contrast.
    // INFERENCE_control_group = 'complement'
}

// ----------------------------------------------------------------------------
// 3. Execution profiles and library threads
// ----------------------------------------------------------------------------
env {
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    NUMEXPR_MAX_THREADS  = '1'
    POLARS_MAX_THREADS   = '1'
}

profiles {
    // Local profile
    local {
        process {
            executor = 'local'
        }

        // Optional: Set work/singularity-cache directory for local runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // TO-DO, SLURM profile
    slurm {
        process {
            executor = 'slurm'
            queue = 'short,normal,long' // TO-DO, YOU set the SLURM partition
            // The GPU request for inference_perturbo comes from
            // nextflow.config's withName block; adjust it there if your
            // partition names its GPUs differently.
        }

        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // Google Cloud profile
    // TO-DO, YOU set google_bucket, google_project and google_region -- they
    // are params, and nextflow.config's placeholders point at the IGVF project.
    google {
        process {
            executor = 'google-batch'
        }

        // Optional: Set work/singularity-cache directory for GCP runs
        workDir = "${params.google_bucket}/work"
        singularity.cacheDir = "${params.google_bucket}/singularity-cache"
    }
}
