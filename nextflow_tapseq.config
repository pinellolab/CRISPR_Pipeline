includeConfig 'conf/provenance.config'

// nextflow.config (in the pipeline root) is always loaded automatically, even
// when this file is also passed via `-c`. Everything below is a deliberate
// DELTA from nextflow.config's defaults for a TAP-seq screen -- do not restate
// values that already match nextflow.config, since Nextflow deep-merges
// params/containers maps and duplicated values just drift out of sync
// silently (as INFERENCE_PERTURBO_MAX_CHUNK_CELLS and containers.perturbo did).
//
// The values here are the ones a validated TAP-seq chr8 run used: 126,154 cells
// against a 68-gene amplification panel, full pipeline, non-targeting guides
// landing at 4.7% for a nominal 5%. Run it as
//
//     nextflow run main.nf -c nextflow_tapseq.config -profile local --input <samplesheet>
//
// Everything not listed below -- container pins, PerTurbo's SVI and CRT memory
// knobs, publishing, reporting, the per-process resource table -- is inherited
// from nextflow.config on purpose.

// Same library thread caps as nextflow.config -- this file stands alone and
// includes nothing from it, so the scope has to be repeated here or every
// TAP-seq task sizes its OpenBLAS/pyarrow/R pools to the whole host. The
// measurements and rationale live on the block in nextflow.config and were in
// fact taken on this screen; the sceptre opt-in lives in the shared module and
// applies to every config.
env {
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    NUMEXPR_MAX_THREADS  = '1'
    POLARS_MAX_THREADS   = '1'
}

params {
    input = null
    outdir = './pipeline_outputs'

    // ---- The panel ---------------------------------------------------------
    // A targeted assay amplifies tens of genes, so the whole-transcriptome QC
    // floors below are the wrong instrument here and the GTF -- which for this
    // assay *is* the amplification panel -- is the right one.

    // Keep only the genes the GTF defines. Without it, whole-transcriptome
    // mapping of a targeted library yields thousands of near-empty off-panel
    // genes, each tested against every guide and each widening the BH family.
    // No expression threshold separates them from genuinely lowly expressed
    // panel genes: on the chr8 screen a 1%-of-cells filter dropped 14 panel
    // genes while keeping 14 off-panel ones.
    REFERENCE_restrict_genes_to_gtf = true

    // TO-DO, YOU set this: the screen's OWN panel GTF, not a GENCODE release.
    // REFERENCE_restrict_genes_to_gtf takes the panel from whatever GTF the run
    // resolves, so pointing this at a transcriptome-wide annotation restricts
    // nothing. The pipeline falls back to REFERENCE_gtf_download_path (a full
    // GENCODE release, inherited from nextflow.config) when this path does not
    // exist, which is exactly the silent no-op to avoid -- check the path.
    // REFERENCE_gtf_local_path = '/path/to/your_panel.gtf.gz'

    // Retain every observed gene through preprocessing instead of applying the
    // standard 10-cell prefilter, which on a 68-gene panel can delete a real
    // target outright.
    TAPSEQ_QC_MODE = true

    // The fractional gene-support filter exists to drop genes no test could
    // use; restricting to the panel already did that, so set it low enough to
    // keep every panel gene rather than re-litigating the panel by expression.
    // (0.000001 == 1e-06; must be a fraction in [0, 1).)
    QC_min_cells_per_gene = 0.000001

    // 500 genes per cell is a whole-transcriptome cell-quality floor: a cell
    // that expresses 60 of a 68-gene panel is a good cell and would fail it.
    // Cell calling is done by QC_barcode_filter below instead.
    QC_min_genes_per_cell = 10

    // ---- Library chemistry -------------------------------------------------
    // The chr8 screen needed no override here: an empty spacer_tag, no guide
    // reverse-complement, and 'knee2' barcode filtering are all nextflow.config
    // defaults, and a site config must not restate a default (see the header).
    // Your library may differ -- check seqspeccheck/guide_seqSpec_plots in your
    // output directory for what your metadata recommends, and set only what
    // actually differs:
    //   spacer_tag = 'TAGCTCTTAAAC'          // scans the whole read
    //   reverse_complement_guides = true
    //   QC_barcode_filter = 'knee'           // more permissive cell calling
    GUIDE_ASSIGNMENT_capture_method = 'crop-seq'

    // ---- Control group ------------------------------------------------------
    // INFERENCE_control_group names the cells a perturbation is compared
    // against, once, for both SCEPTRE and PerTurbo. It is deliberately NOT set
    // here, and neither is the older per-method INFERENCE_PERTURBO_CRT_POOL:
    // setting one per-method parameter overrides the shared setting for that
    // method alone and makes the two methods answer different questions.
    //
    // nextflow.config's 'auto' default follows the declared
    // Multiplicity_of_infection: low -> compare against the non-targeting
    // cells, high -> compare against the complement. A TAP-seq screen usually
    // measures as one guide per cell, so 'auto' resolves to the
    // non-targeting-anchored contrast -- and on this screen that was the wrong
    // answer. All 30 non-targeting guides had their cells in a single 10x lane:
    // 2,033 of the 2,049 control-only cells. A non-targeting-anchored pool is
    // then effectively one batch, so it confounds the contrast with the lane
    // and makes any non-targeting calibration check meaningless -- it is
    // scoring the lane it was built from. 'complement' is correct there,
    // despite the low measured MOI:
    //
    //   INFERENCE_control_group = 'complement'
    //
    // Do not copy that line blindly. Crosstab the control-only cells against
    // your screen's batch column first and look at how they spread; if they
    // spread across lanes, leave the setting alone and let 'auto' follow the
    // declared MOI.

    // Left at nextflow.config's defaults on purpose:
    //  - INFERENCE_SCEPTRE_GENE_CHUNK_SIZE: with INFERENCE_SCEPTRE_CHUNK_MODE
    //    at 'auto', a panel of tens of genes never chunks, so any value here
    //    is a no-op that would only drift.
    //  - DEMO_MODE, INFERENCE_predefined_pairs_to_test: per-run choices, not
    //    properties of the assay.

    // Per-process resource limits
    max_cpus = 16          // TO-DO, YOU set this limit
    max_memory = '128.GB'  // TO-DO, YOU set this limit
}


// Define compute profiles
//
// Same shape as nextflow_cc.config's: one stanza per executor, with the TO-DO
// markers sitting where a site has to edit. The retry strategies, queue sizes,
// GCP timeouts and boot disk are inherited from nextflow.config's own profile
// bodies rather than copied, so nothing below diverges from the pipeline
// default except where a comment says so.
profiles {
    // Local profile
    local {
        process {
            executor = 'local'
        }

        // Optional: Set work/singularity-cache directory for local runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // TO-DO, SLURM profile
    slurm {
        process {
            executor = 'slurm'
            queue = 'short,normal,long' // TO-DO, YOU set the SLURM partition
            // The GPU request for inference_perturbo comes from
            // nextflow.config's withName block; adjust it there if your
            // partition names its GPUs differently.
        }

        // Optional: Set work/singularity-cache directory for SLURM runs
        workDir = './work'
        singularity.cacheDir = './singularity-cache'
    }

    // Google Cloud profile
    // TO-DO, YOU set google_bucket, google_project and google_region -- they
    // are params, and nextflow.config's placeholders point at the IGVF project.
    google {
        process {
            executor = 'google-batch'
        }

        // Optional: Set work/singularity-cache directory for GCP runs
        workDir = "${params.google_bucket}/work"
        singularity.cacheDir = "${params.google_bucket}/singularity-cache"
    }
}
