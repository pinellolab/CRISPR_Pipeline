+def _load_gene_by_element_mask(
+    data,
+    *,
+    modality_key: str | None,
+    varm_key: str,
+    names_uns_key: str | None,
+    element_names: list[str],
+) -> sparse.csr_matrix:
+    """Load and align a gene-by-element mask to the CLI perturbation order."""
+    adata = _resolve_adata(data, modality_key)
+    if varm_key not in adata.varm:
+        raise KeyError(f"Gene-by-element mask '{varm_key}' was not found in analysis modality .varm.")
+    raw = adata.varm[varm_key]
+    if isinstance(raw, pd.DataFrame):
+        source_names = [str(x) for x in raw.columns]
+        matrix = sparse.csr_matrix(raw.to_numpy())
+    else:
+        if names_uns_key is None:
+            raise ValueError(
+                "--gene-by-element-names-uns-key is required when the gene-by-element mask "
+                "does not carry DataFrame column labels."
+            )
+        if names_uns_key not in adata.uns:
+            raise KeyError(f"Gene-by-element names '{names_uns_key}' were not found in analysis modality .uns.")
+        source_names = [str(x) for x in np.asarray(adata.uns[names_uns_key]).reshape(-1)]
+        matrix = sparse.csr_matrix(raw)
+    if matrix.shape != (adata.n_vars, len(source_names)):
+        raise ValueError(
+            "Gene-by-element mask must have shape (n_genes, n_named_elements); "
+            f"got {matrix.shape} for {adata.n_vars} genes and {len(source_names)} names."
+        )
+    if len(set(source_names)) != len(source_names):
+        raise ValueError("Gene-by-element mask names must be unique.")
+    source_index = {name: idx for idx, name in enumerate(source_names)}
+    missing = [name for name in element_names if name not in source_index]
+    if missing:
+        raise ValueError(
+            "Gene-by-element mask is missing perturbations used by the analysis: " + ", ".join(missing[:20])
+        )
+    aligned = matrix[:, [source_index[name] for name in element_names]].astype(bool).tocsr()
+    empty = np.flatnonzero(np.asarray(aligned.getnnz(axis=0)) == 0)
+    if empty.size:
+        preview = ", ".join(element_names[int(i)] for i in empty[:20])
+        raise ValueError(f"Gene-by-element mask has no tested genes for {empty.size} perturbations: {preview}")
+    print(
+        "[perturbo] Local pair mask loaded: "
+        f"{aligned.nnz:,} tested gene-element pairs out of {aligned.shape[0] * aligned.shape[1]:,}."
+    )
+    return aligned
+
