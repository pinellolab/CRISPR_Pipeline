+def subset_control_fit_genes(control_fit: ControlFit, gene_indices: np.ndarray) -> ControlFit:
+    """Select the gene axis of a stage-1 fit for a local stage-2 fit.
+
+    Stage 1 is intentionally fit once using all genes.  A cis pair mask can
+    then reuse that fit while stage 2 loads and optimizes only the genes
+    requested by the perturbations in the current chunk.
+    """
+    idx = np.asarray(gene_indices, dtype=int)
+    if idx.ndim != 1 or idx.size == 0:
+        raise ValueError("gene_indices must be a non-empty one-dimensional array.")
+
+    def first_axis(value):
+        return None if value is None else value[idx]
+
+    def last_axis(value):
+        return None if value is None else value[..., idx]
+
+    baseline = control_fit.baseline_posterior
+    if baseline is not None:
+        baseline = BaselinePosteriorSummary(
+            beta_0_loc=first_axis(baseline.beta_0_loc),
+            beta_0_scale=first_axis(baseline.beta_0_scale),
+            theta_log_loc=first_axis(baseline.theta_log_loc),
+            theta_log_scale=first_axis(baseline.theta_log_scale),
+        )
+
+    return ControlFit(
+        beta_0=first_axis(control_fit.beta_0),
+        theta=first_axis(control_fit.theta),
+        noise_scale=first_axis(control_fit.noise_scale),
+        factor_loadings=last_axis(control_fit.factor_loadings),
+        factor_scores=control_fit.factor_scores,
+        factor_center=first_axis(control_fit.factor_center),
+        pca_loadings=last_axis(control_fit.pca_loadings),
+        size_factors=control_fit.size_factors,
+        losses=control_fit.losses,
+        svi_result=control_fit.svi_result,
+        baseline_posterior=baseline,
+        pi_outlier=first_axis(control_fit.pi_outlier),
+        theta_outlier=first_axis(control_fit.theta_outlier),
+        outlier_mean_shift=first_axis(control_fit.outlier_mean_shift),
+        covariate_coef=last_axis(control_fit.covariate_coef),
+        guide_random_effect_tau=first_axis(control_fit.guide_random_effect_tau),
+        guide_random_effect_log_tau_loc=control_fit.guide_random_effect_log_tau_loc,
+        guide_random_effect_log_tau_scale=control_fit.guide_random_effect_log_tau_scale,
+        count_censoring_threshold=first_axis(control_fit.count_censoring_threshold),
+    )
+
