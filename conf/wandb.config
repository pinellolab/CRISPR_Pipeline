// Optional W&B HTML telemetry. Credentials remain in WB_IGVF.
// bin/run_with_wandb.sh consumes the corresponding WANDB_* environment values.
params {
    WANDB_enabled = false
    WANDB_project = 'crispr-pipeline'
    WANDB_entity = ''
    WANDB_token_env = 'WB_IGVF'
    WANDB_poll_seconds = 30
    WANDB_max_bytes = 20000000
    WANDB_layout = 'single-html'
}

trace {
    enabled = true
    overwrite = true
    sep = '\t'
    fields = 'task_id,hash,native_id,process,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,rss,peak_rss,rchar,wchar,read_bytes,write_bytes,container,tag,workdir'
}
