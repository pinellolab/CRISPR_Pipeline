// Opt-in while nf-crispr-dashboard is being validated for registry release.
// Once published, this config can be included from the pipeline default.
plugins {
    id 'nf-crispr-dashboard@0.1.0'
}

params.DASHBOARD_PLUGIN = [
    enabled: true,
    upload: true,
    project: 'crispr-pipeline',
    tokenEnv: 'WB_IGVF',
    pollSeconds: 20,
    server: [
        enabled: false,
        host: '127.0.0.1',
        port: 8787,
        refreshSeconds: 30,
        tokenEnv: 'CRISPR_DASHBOARD_TOKEN'
    ]
]
