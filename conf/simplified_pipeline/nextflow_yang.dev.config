// Yang run — compact Slurm overlay for pinellolab/CRISPR_Pipeline v1.1.0.
// Use with the v1.1.0 checkout and -profile slurm -c nextflow_yang.dev.config.
// Supply absolute --input / --outdir paths. Set site paths and queues below.
// This file overrides Yang assay settings. Pipeline defaults remain in nextflow.config.
params {
    // 1. Run inputs and stop point (supply absolute --input / --outdir at launch)
    input = null
    outdir = './pipeline_outputs_yang_dev'
    ANALYSIS_mode = 'full'             // 'full': end-to-end; 'checkpoint': finish Post Concatenation QC
    // For a NEW continuation: set mode='continue', a NEW outdir and this manifest.
    // ANALYSIS_parent_manifest = '/shared/results/preinference_checkpoint/RUN/preinference_manifest.json'
    // ANALYSIS_keep_cells_tsv = '/shared/edits/keep_cells.tsv'       // optional cell_id allowlist
    // ANALYSIS_covariates_tsv = '/shared/edits/covariates.tsv'       // optional external_* numeric columns

    // 2. Assay and guide-read design — preserved from nextflow_yang.config
    ENABLE_DATA_HASHING = false
    is_10x3v3 = true
    reverse_complement_guides = false
    spacer_tag = 'GAGTACATGGGGG'       // verify orientation/anchor with SeqSpec QC
    use_multimapping = false
    DUAL_GUIDE = false
    REFERENCE_transcriptome = 'human'
    use_igvf_reference = true
    Multiplicity_of_infection = 'high'

    // 3. RNA and cell QC — the old 500 detected-gene filter no longer runs.
    // 500 UMIs + two-sided log1p MAD filters are a NEW policy, not equivalent.
    QC_barcode_filter = 'none'        // Yang policy; pipeline default is 'knee2'
    QC_min_counts_per_cell = 500
    QC_MAD_total_counts = 5.0         // 0 disables this outlier filter
    QC_MAD_n_genes = 5.0              // 0 disables this outlier filter
    QC_pct_mito = 15                  // preserve Yang's mitochondrial ceiling
    QC_min_cells_per_gene = 0.05      // gene detected in at least 5% of retained cells
    ENABLE_SCRUBLET = false           // preserve Yang; pipeline default is true
    QC_target_gene_rescue = true     // optional rescue below the gene-prevalence cutoff

    // 4. Guide assignment and NEW post-assignment cell filters
    GUIDE_ASSIGNMENT_method = 'sceptre' // alternative: 'cleanser'
    GUIDE_ASSIGNMENT_capture_method = 'CROP-seq'
    GUIDE_ASSIGNMENT_SCEPTRE_probability_threshold = 0.8 // preserve Yang; pipeline default is 'default'
    GUIDE_ASSIGNMENT_SCEPTRE_n_em_rep = 5                // preserve Yang; pipeline default is 'default'
    // If switching to Cleanser, use capture_method='crop-seq' or 'direct-capture'.
    // GUIDE_ASSIGNMENT_cleanser_probability_threshold = 1
    QC_require_assigned_guide = true   // NEW dev policy: discard cells with no assigned guide
    GUIDE_ASSIGNMENT_min_guides_per_cell = 1
    GUIDE_ASSIGNMENT_max_guides_per_cell = 15 // NEW dev cap; 0 disables the upper cap
    GUIDE_MAPPING_QC_action = 'error'  // stop on failed guide recovery; inherit pipeline thresholds
    ENABLE_CLONE_REMOVAL = true      // optional high-MOI clone removal; changes retained cells

    // 5. Inference — default runs SCEPTRE + PerTurbo local, PerTurbo global
    INFERENCE_method = 'default'      // also: 'sceptre', 'perturbo', 'sceptre,perturbo'
    INFERENCE_target_guide_pairing_strategy = 'default'
    INFERENCE_max_target_distance_bp = 1000000 // local pairs; does NOT limit global testing
    INFERENCE_control_group = 'auto'  // shared contrast; high MOI resolves to complement/all-cells
    // For custom local pairs, change BOTH method and pairing strategy:
    // INFERENCE_method = 'sceptre,perturbo'
    // INFERENCE_target_guide_pairing_strategy = 'predefined_pairs'
    // INFERENCE_predefined_pairs_to_test = '/shared/target_guide_pairs.csv'

    // NEW shared covariate switches: these change the statistical model.
    INFERENCE_COV_BATCH = true
    INFERENCE_COV_DETECTED_GENES = true
    INFERENCE_COV_GUIDE_UMIS = true
    INFERENCE_COV_GUIDE_COUNT = false
    INFERENCE_COV_MITOCHONDRIAL = false
    INFERENCE_COV_RIBOSOMAL = false
    INFERENCE_COV_CUSTOM = 'auto'      // includes supported supplied custom covariates

    // 6. Important new QC outputs and practical GPU memory controls
    ENABLE_POSTCONCAT_EMBEDDING_QC = true // temporary visualization; delivered RNA stays raw
    ENABLE_SEQUENCING_SATURATION = true
    ENABLE_NTC_CALIBRATION = true     // extra post-inference calibration; requires both methods
    INFERENCE_PERTURBO_DEVICE = 'gpu'
    INFERENCE_PERTURBO_GENE_CHUNK_SIZE = 32 // bound stage-two GPU memory; 0 fits all genes together
    INFERENCE_PERTURBO_MAX_CHUNK_CELLS = 20000
    INFERENCE_PERTURBO_LOCAL_MAX_CHUNK_CELLS = 20000
    INFERENCE_PERTURBO_GLOBAL_RESULTS_FORMAT = 'parquet'
    // Optimizer/CRT settings and model container pins inherit v1.1.0 defaults.

    // 7. Site resource limits — Yang's 16 CPUs / 128 GB.
    max_cpus = 16
    max_memory = '128.GB'
}

profiles {
    slurm {
        // Set YANG_SLURM_QUEUE if your CPU partition differs from the old config.
        process.queue = System.getenv('YANG_SLURM_QUEUE') ?: 'troctolite'
        workDir = System.getenv('YANG_NXF_WORK') ?: './work_yang_dev'
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = System.getenv('YANG_SIF_CACHE') ?: './singularity-cache'
}

process {
    // Explicit overrides also cap dev selectors with fixed CPU/RAM requests.
    cpus = { Math.min(16, params.max_cpus as int) }
    memory = { [50.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    withName: 'mappingGuide|mappingHashing|mappingscRNA|guide_assignment_sceptre|inference_sceptre|sceptre_chunk_prepare|sceptre_chunk_merge|downloadReference|mergeMudata|buildCatalogElement|buildCatalogGuide' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [100.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'inference_perturbo' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [100.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        // EDIT/EXPORT GPU queue if troctolite does not provide GPUs.
        queue = System.getenv('YANG_SLURM_GPU_QUEUE') ?: (System.getenv('YANG_SLURM_QUEUE') ?: 'troctolite')
        clusterOptions = '--gres=gpu:1' // site may require a GPU model; old config requested 4
        accelerator = null            // SLURM uses --gres, not dev's Google A100 request
        containerOptions = '--nv'
    }
}
