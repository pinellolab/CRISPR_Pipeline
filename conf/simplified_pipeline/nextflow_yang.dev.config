// Yang run — compact Slurm overlay for pinellolab/CRISPR_Pipeline v1.1.0.
// Use with the v1.1.0 checkout and -profile slurm -c nextflow_yang.dev.config.
// Supply absolute --input / --outdir paths. Set site paths and queues below.
// This file overrides Yang assay settings. Pipeline defaults remain in nextflow.config.

// ----------------------------------------------------------------------------
// 1. Essential settings
// ----------------------------------------------------------------------------
// Active lines are assay overrides. Commented lines show inherited defaults to review.
params {
    // Run mode and results. Supply --input /path/to/samplesheet.csv at launch.
    outdir = './pipeline_outputs_yang_dev'
    ANALYSIS_mode = 'full'

    // Assay and read processing
    Multiplicity_of_infection = 'high'
    ENABLE_DATA_HASHING = false
    DUAL_GUIDE = false
    // is_BaseEditing = false
    // scrna_workflow = 'standard'
    use_multimapping = false
    // replace_barcodes = false
    // bc_replacement_file = ''
    is_10x3v3 = true
    reverse_complement_guides = false
    // A spacer tag enables whole-read guide search. Verify in SeqSpec QC.
    spacer_tag = 'GAGTACATGGGGG'

    // RNA reference and annotation
    REFERENCE_transcriptome = 'human'
    use_igvf_reference = true
    // REFERENCE_gtf_download_path = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gtf.gz'
    // REFERENCE_gtf_local_path = '/path/to/gencode_gtf.gtf.gz'
    // REFERENCE_restrict_genes_to_gtf = false
    // TAPSEQ_QC_MODE = false

    // RNA and cell QC
    // The barcode-rank plot is automatic. 'none' skips knee filtering and keeps the plot.
    QC_barcode_filter = 'none'
    QC_min_counts_per_cell = 500
    QC_MAD_total_counts = 5.0
    QC_MAD_n_genes = 5.0
    QC_pct_mito = 15
    QC_min_cells_per_gene = 0.05
    ENABLE_SCRUBLET = false

    // Guide assignment and inference
    GUIDE_ASSIGNMENT_method = 'sceptre'
    GUIDE_ASSIGNMENT_capture_method = 'CROP-seq'
    INFERENCE_method = 'default'
    // Applies only to distance-based local pairs.
    INFERENCE_max_target_distance_bp = 1000000

    // Site resource limits
    max_cpus = 16
    max_memory = '128.GB'
}

// ----------------------------------------------------------------------------
// 2. Advanced overrides
// ----------------------------------------------------------------------------
params {
    // Optional path for launches that get their samplesheet from a run-specific config.
    input = null

    // Gene rescue, guide eligibility, and clones
    QC_target_gene_rescue = true
    GUIDE_ASSIGNMENT_SCEPTRE_probability_threshold = 0.8
    GUIDE_ASSIGNMENT_SCEPTRE_n_em_rep = 5
    QC_require_assigned_guide = true
    GUIDE_ASSIGNMENT_min_guides_per_cell = 1
    // Zero leaves the number of assigned guides per cell uncapped.
    GUIDE_ASSIGNMENT_max_guides_per_cell = 15
    GUIDE_MAPPING_QC_action = 'error'
    ENABLE_CLONE_REMOVAL = true

    // Inference design and covariates
    INFERENCE_target_guide_pairing_strategy = 'default'
    INFERENCE_control_group = 'auto'
    INFERENCE_COV_BATCH = true
    INFERENCE_COV_DETECTED_GENES = true
    INFERENCE_COV_GUIDE_UMIS = true
    INFERENCE_COV_GUIDE_COUNT = false
    INFERENCE_COV_MITOCHONDRIAL = false
    INFERENCE_COV_RIBOSOMAL = false
    INFERENCE_COV_CUSTOM = 'auto'

    // QC diagnostics and PerTurbo memory
    ENABLE_POSTCONCAT_EMBEDDING_QC = true
    ENABLE_SEQUENCING_SATURATION = true
    ENABLE_NTC_CALIBRATION = true
    INFERENCE_PERTURBO_DEVICE = 'gpu'
    // Bound stage-two GPU fit memory by splitting genes across fits.
    INFERENCE_PERTURBO_GENE_CHUNK_SIZE = 32
    INFERENCE_PERTURBO_MAX_CHUNK_CELLS = 20000
    INFERENCE_PERTURBO_LOCAL_MAX_CHUNK_CELLS = 20000
    INFERENCE_PERTURBO_GLOBAL_RESULTS_FORMAT = 'parquet'

    // For a new continuation set ANALYSIS_mode to continue, pick a new outdir,
    // and supply a published checkpoint manifest. Optional files add cell selection or covariates.
    // ANALYSIS_parent_manifest = '/shared/results/preinference_checkpoint/RUN/preinference_manifest.json'
    // ANALYSIS_keep_cells_tsv = '/shared/edits/keep_cells.tsv'
    // ANALYSIS_covariates_tsv = '/shared/edits/covariates.tsv'

    // To use predefined pairs, set both the method and pairing strategy.
    // INFERENCE_method = 'sceptre,perturbo'
    // INFERENCE_target_guide_pairing_strategy = 'predefined_pairs'
    // INFERENCE_predefined_pairs_to_test = '/shared/target_guide_pairs.csv'

    // For CLEANSER, confirm the capture method ('crop-seq' or 'direct-capture').
    // GUIDE_ASSIGNMENT_cleanser_probability_threshold = 1
}

// ----------------------------------------------------------------------------
// 3. Slurm execution profiles and resources
// ----------------------------------------------------------------------------
profiles {
    slurm {
        // Set YANG_SLURM_QUEUE if your CPU partition differs from the old config.
        process.queue = System.getenv('YANG_SLURM_QUEUE') ?: 'troctolite'
        workDir = System.getenv('YANG_NXF_WORK') ?: './work_yang_dev'
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = System.getenv('YANG_SIF_CACHE') ?: './singularity-cache'
}

process {
    // Explicit overrides also cap dev selectors with fixed CPU/RAM requests.
    cpus = { Math.min(16, params.max_cpus as int) }
    memory = { [50.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    withName: 'mappingGuide|mappingHashing|mappingscRNA|guide_assignment_sceptre|inference_sceptre|sceptre_chunk_prepare|sceptre_chunk_merge|downloadReference|mergeMudata|buildCatalogElement|buildCatalogGuide' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [100.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'inference_perturbo' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [100.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        // EDIT/EXPORT GPU queue if troctolite does not provide GPUs.
        queue = System.getenv('YANG_SLURM_GPU_QUEUE') ?: (System.getenv('YANG_SLURM_QUEUE') ?: 'troctolite')
        clusterOptions = '--gres=gpu:1' // site may require a GPU model; old config requested 4
        accelerator = null            // SLURM uses --gres, not dev's Google A100 request
        containerOptions = '--nv'
    }
}
