// Optional, fail-open Axiom telemetry. The wrapper in bin/run_with_axiom.sh
// supplies per-run paths and IDs; credentials remain in AXIOM_IGVF.
params {
    AXIOM_enabled = true
    AXIOM_dataset = 'crispr-pipeline'
    AXIOM_token_env = 'AXIOM_IGVF'
    AXIOM_ingest_url = 'https://us-east-1.aws.edge.axiom.co/v1/ingest/{dataset}'
    AXIOM_api_url = 'https://api.axiom.co'
    AXIOM_create_dashboard = true
    AXIOM_max_bytes = 20000000
    AXIOM_max_event_bytes = 8192
    AXIOM_poll_seconds = 2
    AXIOM_heartbeat_seconds = 60
    AXIOM_run_id = System.getenv('AXIOM_RUN_ID') ?: ''
    AXIOM_run_name = System.getenv('AXIOM_RUN_NAME') ?: ''
    AXIOM_event_file = System.getenv('AXIOM_EVENT_FILE') ?: ''
}

// TraceFileObserver is Nextflow's native per-process lifecycle observer. It
// writes a bounded set of operational fields after every terminal task state.
trace {
    enabled = true
    overwrite = true
    sep = '\t'
    fields = 'task_id,hash,native_id,process,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,rss,peak_rss,rchar,wchar,read_bytes,write_bytes,container,tag,workdir'
}

dag {
    enabled = true
    overwrite = true
}
